{
  "name": "@sagargupta1610/skillcheck",
  "version": "0.2.9",
  "description": "Conformance suite for Agent Skills: lint SKILL.md against the spec, run it against real agent runtimes, publish a compatibility matrix",
  "keywords": [
    "agent-skills",
    "skill",
    "SKILL.md",
    "claude-code",
    "conformance",
    "lint",
    "agents",
    "skill-linter",
    "static-analysis",
    "github-action",
    "sarif",
    "pre-commit"
  ],
  "license": "MIT",
  "author": "Sagar Gupta <sg85207@gmail.com> (https://github.com/Sagargupta16)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sagargupta16/skillcheck.git"
  },
  "type": "module",
  "bin": {
    "skillcheck": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc -p site",
    "docs:rules": "node scripts/gen-rules-doc.ts",
    "site:build": "tsup --config tsup.site.config.ts",
    "site:serve": "node scripts/serve-site.ts",
    "corpus": "pnpm build && node scripts/corpus-scan.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
